{
  "name": "shortpipeline-motion-canvas",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:scene && npm run build:engine",
    "build:scene": "esbuild scene.js --bundle --platform=browser --format=iife --outfile=dist/scene.js",
    "build:engine": "esbuild engine/index.js --bundle --platform=browser --format=iife --outfile=dist/engine.js"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "three": "0.187.0"
  },
  "private": true
}
